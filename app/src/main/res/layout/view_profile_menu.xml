<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_map_popup"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/profile_menu_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="@string/profile_menu_title"
        android:textColor="@color/nyama_orange"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/profile_menu_delete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:includeFontPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/profile_delete"
        android:textColor="@color/white"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/profile_menu_history"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/profile_clear_history"
        android:textColor="@color/white"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/profile_menu_likes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/profile_clear_likes"
        android:textColor="@color/white"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/profile_menu_hidden"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/profile_clear_hidden"
        android:textColor="@color/white"
        android:textSize="15sp" />

</LinearLayout>
