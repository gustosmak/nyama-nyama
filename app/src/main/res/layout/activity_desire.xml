<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/desire_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nyama_gray"
    tools:context=".DesireActivity">

    <ImageButton
        android:id="@+id/desire_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_icon_button"
        android:contentDescription="@string/cd_back"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/desire_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/desire_next"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/desire_back">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="8dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/desire_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/desire_title"
                android:textColor="@color/white"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/desire_hunger_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/desire_hunger_label"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/hunger_end_low"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/hunger_end_low"
                    android:textColor="@color/nyama_text_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/hunger_end_high"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="@string/hunger_end_high"
                    android:textColor="@color/nyama_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/hunger_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="100"
                android:maxHeight="28dp"
                android:minHeight="28dp"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:progress="0"
                android:progressDrawable="@drawable/bg_hunger_progress"
                android:splitTrack="false"
                android:thumb="@drawable/bg_hunger_thumb"
                android:thumbOffset="0dp" />

            <TextView
                android:id="@+id/hunger_popup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_hunger_popup"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="@string/hunger_none"
                android:textColor="@color/nyama_gray"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/budget_frames_title2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Рамки бюджета"
                android:textColor="@color/white"
                android:textSize="22sp" />

            <com.DirtyTeam.sky.NyamaNyama.TagFlowLayout
                android:id="@+id/budget_tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipChildren="false" />

            <TextView
                android:id="@+id/budget_frames_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Добавьте комментарий"
                android:textColor="@color/white"
                android:textSize="22sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/desire_comment_input"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/desire_comment_hint"
                    app:boxStrokeColor="@color/nyama_orange_box"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="1dp"
                    app:hintTextColor="@color/nyama_orange">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/desire_comment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:imeOptions="actionDone"
                        android:inputType="textCapSentences"
                        android:maxLength="100"
                        android:maxLines="1"
                        android:minHeight="96dp"
                        android:paddingEnd="44dp"
                        android:paddingBottom="40dp"
                        android:textColor="@color/white" />

                </com.google.android.material.textfield.TextInputLayout>

                <ImageButton
                    android:id="@+id/comment_done"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="@string/cd_hide_keyboard"
                    android:focusable="false"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_check"
                    android:visibility="gone" />

            </FrameLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="20dp" />

        </LinearLayout>
    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/desire_next"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_budget_next"
        android:backgroundTint="@null"
        android:minHeight="52dp"
        android:text="@string/budget_next"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
