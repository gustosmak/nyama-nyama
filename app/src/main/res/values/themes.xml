<resources>
    <style name="Base.Theme.NyamaNyama" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/nyama_orange</item>
        <item name="colorPrimaryContainer">@color/nyama_orange_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/nyama_orange</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/nyama_gray</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="android:colorBackground">@color/nyama_gray</item>
        <item name="android:windowBackground">@color/nyama_gray</item>
    </style>

    <style name="Theme.NyamaNyama" parent="Base.Theme.NyamaNyama" />

    <style name="Theme.NyamaNyama.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nyama_gray</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_mouth_nyamouth</item>
        <item name="postSplashScreenTheme">@style/Theme.NyamaNyama</item>
    </style>

    <style name="TextAppearance.NyamaNyama.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/montserrat_bold</item>
        <item name="fontFamily">@font/montserrat_bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Widget.NyamaNyama.MenuButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">68dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAppearance">@style/TextAppearance.NyamaNyama.Button</item>
        <item name="cornerRadius">28dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="TextAppearance.NyamaNyama.CompactButton" parent="TextAppearance.NyamaNyama.Button">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.NyamaNyama.CompactButton" parent="Widget.NyamaNyama.MenuButton">
        <item name="android:minHeight">44dp</item>
        <item name="android:textAppearance">@style/TextAppearance.NyamaNyama.CompactButton</item>
        <item name="cornerRadius">22dp</item>
    </style>

</resources>
