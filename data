PRAGMA foreign_keys = ON;

-- 1. Пользователи (аутентификация по email)
CREATE TABLE users (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    email TEXT(120) NOT NULL UNIQUE,
    password_hash TEXT(255) NOT NULL,
    is_active INTEGER NOT NULL DEFAULT 1, -- 1 = True, 0 = False
    created_at TIMESTAMP NOT NULL DEFAULT (datetime('now')),
    last_login TIMESTAMP
);

CREATE INDEX idx_users_email ON users(email);


-- 2. Рестораны (данные из OpenStreetMap API)
CREATE TABLE restaurants (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    osm_id TEXT NOT NULL, -- ID объекта в OSM
    osm_type TEXT(20) NOT NULL, -- node, way или relation
    name TEXT NOT NULL,
    address TEXT,
    lat REAL NOT NULL,
    lon REAL NOT NULL,
    cached_at TIMESTAMP NOT NULL DEFAULT (datetime('now')),
    
    -- Уникальность в OSM определяется парой (тип объекта + ID)
    UNIQUE (osm_type, osm_id)
);

CREATE INDEX idx_restaurants_location ON restaurants(lat, lon);


-- 3. Блюда
CREATE TABLE dishes (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    restaurant_id INTEGER NOT NULL,
    name TEXT NOT NULL,
    price REAL NOT NULL,
    calories INTEGER NOT NULL,
    category TEXT, -- burger / shawarma / blin / potato / salad / drink
    is_spicy INTEGER NOT NULL DEFAULT 0,
    is_veg INTEGER NOT NULL DEFAULT 0,
    description TEXT,
    cached_at TIMESTAMP NOT NULL DEFAULT (datetime('now')),
    FOREIGN KEY (restaurant_id) REFERENCES restaurants(id) ON DELETE CASCADE
);

CREATE INDEX idx_dishes_restaurant_id ON dishes(restaurant_id);


-- 4. Заказы (история)
CREATE TABLE orders (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL,
    dish_id INTEGER NOT NULL,
    price REAL NOT NULL,
    rating INTEGER CHECK (rating >= 1 AND rating <= 5), -- 1–5
    created_at TIMESTAMP NOT NULL DEFAULT (datetime('now')),
    FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
    FOREIGN KEY (dish_id) REFERENCES dishes(id) ON DELETE CASCADE
);

CREATE INDEX idx_orders_user_created ON orders(user_id, created_at);
